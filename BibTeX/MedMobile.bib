
@misc{vishwanath_medmobile_2024,
	title = {{MedMobile}: A mobile-sized language model with expert-level clinical capabilities},
	url = {http://arxiv.org/abs/2410.09019},
	doi = {10.48550/arXiv.2410.09019},
	shorttitle = {{MedMobile}},
	abstract = {Language models ({LMs}) have demonstrated expert-level reasoning and recall abilities in medicine. However, computational costs and privacy concerns are mounting barriers to wide-scale implementation. We introduce a parsimonious adaptation of phi-3-mini, {MedMobile}, a 3.8 billion parameter {LM} capable of running on a mobile device, for medical applications. We demonstrate that {MedMobile} scores 75.7\% on the {MedQA} ({USMLE}), surpassing the passing mark for physicians ({\textasciitilde}60\%), and approaching the scores of models 100 times its size. We subsequently perform a careful set of ablations, and demonstrate that chain of thought, ensembling, and fine-tuning lead to the greatest performance gains, while unexpectedly retrieval augmented generation fails to demonstrate significant improvements},
	number = {{arXiv}:2410.09019},
	publisher = {{arXiv}},
	author = {Vishwanath, Krithik and Stryker, Jaden and Alyakin, Anton and Alber, Daniel Alexander and Oermann, Eric Karl},
	urldate = {2025-01-02},
	date = {2024-10-11},
	eprinttype = {arxiv},
	eprint = {2410.09019 [cs]},
	keywords = {Computer Science - Computation and Language},
	file = {Preprint PDF:C\:\\Users\\MHTrXz\\Zotero\\storage\\EM5M2VU8\\Vishwanath et al. - 2024 - MedMobile A mobile-sized language model with expert-level clinical capabilities.pdf:application/pdf;Snapshot:C\:\\Users\\MHTrXz\\Zotero\\storage\\FEZYE62B\\2410.html:text/html},
}
