	file = {Preprint PDF:C\:\\Users\\MHTrXz\\Zotero\\storage\\DWAFAJV4\\Kim et al. - 2024 - Small Language Models Learn Enhanced Reasoning Skills from Medical Textbooks.pdf:application/pdf;Snapshot:C\:\\Users\\MHTrXz\\Zotero\\storage\\TBLB8NFU\\2404.html:text/html},
