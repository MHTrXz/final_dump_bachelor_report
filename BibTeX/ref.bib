	keywords = {Computer Science - Computation and Language, Computer Science - Human-Computer Interaction, Computer Science - Machine Learning},
	file = {Preprint PDF:C\:\\Users\\MHTrXz\\Zotero\\storage\\NDA2U74L\\Manes et al. - 2024 - K-QA A Real-World Medical Q&A Benchmark.pdf:application/pdf;Snapshot:C\:\\Users\\MHTrXz\\Zotero\\storage\\U9WZBPZ3\\2401.html:text/html},
